{
  "version": 2,
  "framework": null,
  "regions": ["hnd1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/(build|css|js|images|avatars|selfies|vendor|favicon.ico|robots.txt|userdefault-160x160.jpg)(.*)",
      "dest": "/public/$1$2",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/storage/selfies/(.*)",
      "dest": "/public/selfies/$1",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "src": "/storage/avatars/(.*)",
      "dest": "/public/avatars/$1",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "VERCEL": "1",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views"
  }
}
