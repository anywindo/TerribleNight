<?php

use Illuminate\Support\Facades\Route;
use App\Http\Controllers\Admin\DashboardController;

// Auth Routes
Route::get('/', [\App\Http\Controllers\Web\AuthController::class, 'showLoginForm'])->name('login');
Route::post('/', [\App\Http\Controllers\Web\AuthController::class, 'login']);
Route::post('/logout', [\App\Http\Controllers\Web\AuthController::class, 'logout'])->name('logout');

Route::middleware('auth')->group(function () {
    // Employee App Routes (Tailwind)
    Route::group(['prefix' => 'app', 'middleware' => ['role:Employee']], function() {
        Route::get('/attendance', function () { return view('employee.attendance'); });
    });

    // HR Portal Routes (AdminLTE Components)
    Route::group(['prefix' => 'admin', 'middleware' => ['role:HR']], function() {
        Route::get('/dashboard', [\App\Http\Controllers\Admin\DashboardController::class, 'index'])->name('admin.dashboard');
        Route::get('/attendances', function () { return view('admin.attendances.index'); })->name('admin.attendances');
        Route::get('/corrections', function () { return view('admin.corrections.index'); })->name('admin.corrections');
        Route::get('/employees', [\App\Http\Controllers\Web\Admin\EmployeeController::class, 'index'])->name('admin.employees');
        Route::get('/employees/create', [\App\Http\Controllers\Web\Admin\EmployeeController::class, 'create'])->name('admin.employees.create');
        Route::post('/employees', [\App\Http\Controllers\Web\Admin\EmployeeController::class, 'store'])->name('admin.employees.store');
    });
});
